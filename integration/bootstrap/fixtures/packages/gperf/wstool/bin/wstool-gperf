#!/bin/bash
set -euo pipefail

: "${WST_SRCDIR:?WST_SRCDIR is required}"
: "${WST_PRIVATE:?WST_PRIVATE is required}"
: "${WST_PREFIX:?WST_PREFIX is required}"

source="$WST_SRCDIR"
build="$WST_PRIVATE/build"
mkdir -p "$WST_PREFIX" "$build"

if [ ! -f "$build/Makefile" ]; then
  cd "$build"
  "$source/configure" --disable-maintainer-mode --prefix="$WST_PREFIX"
fi

make -C "$build/lib" -j"${WST_JOBS:-2}"
make -C "$build/src" -j"${WST_JOBS:-2}"
make -C "$build" install
