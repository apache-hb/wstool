amends "package://pkl.konna.cloud/pkl/wstool@1.0.2#/package.pkl"

package { name = "mpc"; version = "1.3.1" }

buildOptions {
  tool = "wstool-autotools"
  buildImage = "bootstrap"
  buildEnvironment { ["WST_MAKE_SUBDIRS"] = "src" }
}

buildDependencies {
  ["wstool-autotools"] = "1.0.0"
  ["gmp"] = "6.3.0"
  ["mpfr"] = "4.2.1"
}

importOptions {
  archive = "https://ftp.gnu.org/gnu/mpc/mpc-1.3.1.tar.gz"
  checksum = "ab642492f5cf882b74aa0cb730cd410a81edcdbec895183ce930e706c1c759b8"
  license = "LGPL-3.0-or-later"
}
