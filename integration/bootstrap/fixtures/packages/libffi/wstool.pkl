amends "modulepath:/package.pkl"

package { name = "libffi"; version = "3.4.6" }

buildOptions {
  tool = "wstool-autotools"
  buildImage = "declared"
  buildEnvironment {
    ["WST_COPY_SOURCE"] = "true"
  }
}

buildDependencies {
  ["wstool-autotools"] = "1.0.0"
  ["glibc"] = "2.39"
}

importOptions {
  archive = "https://github.com/libffi/libffi/releases/download/v3.4.6/libffi-3.4.6.tar.gz"
  checksum = "b0dea9df23c863a7a50e825440f3ebffabd65df1497108e5d437747843895a4e"
  license = "MIT"
}
