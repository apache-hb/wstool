#!/bin/bash
set -euo pipefail

: "${WST_SRCDIR:?WST_SRCDIR is required}"
: "${WST_PRIVATE:?WST_PRIVATE is required}"
: "${WST_PREFIX:?WST_PREFIX is required}"

sysroot="$WST_PRIVATE/sysroot"
build="$WST_PRIVATE/build"
mkdir -p "$sysroot" "$build" "$WST_PREFIX"

export PATH="$sysroot/bin:$PATH"
export JAVA_HOME="$sysroot/jdk"
export CC="$sysroot/bin/x86_64-linux-gnu-gcc --sysroot=$sysroot"
export CXX="$sysroot/bin/x86_64-linux-gnu-g++ --sysroot=$sysroot"
export CFLAGS="--sysroot=$sysroot ${CFLAGS:-}"
export CXXFLAGS="--sysroot=$sysroot ${CXXFLAGS:-}"
export CPPFLAGS="-I$sysroot/usr/include -I$sysroot/include ${CPPFLAGS:-}"
export LDFLAGS="--sysroot=$sysroot -L$sysroot/usr/lib -L$sysroot/lib ${LDFLAGS:-}"
export PKG_CONFIG_PATH="$sysroot/usr/lib/pkgconfig:$sysroot/usr/share/pkgconfig:$sysroot/lib/pkgconfig:$sysroot/share/pkgconfig"

if [ ! -f "$build/spec.gmk" ]; then
  cd "$build"
  bash "$WST_SRCDIR/configure" \
    --with-boot-jdk="$JAVA_HOME" \
    --with-debug-level=release \
    --with-native-debug-symbols=none \
    --disable-warnings-as-errors \
    --with-freetype=system \
    --with-fontconfig=system \
    --with-cups=system \
    --with-alsa=system \
    --with-x=system \
    --with-zlib=system \
    --with-extra-cflags="--sysroot=$sysroot" \
    --with-extra-cxxflags="--sysroot=$sysroot" \
    --with-extra-ldflags="--sysroot=$sysroot -L$sysroot/lib"
fi

if [ "$#" -eq 0 ]; then
  make -C "$build" -j"${WST_JOBS:-2}" images
  image=$(find "$build" -type d -path '*/images/jdk' -print -quit)
  [ -n "$image" ] || { echo "OpenJDK image was not produced" >&2; exit 1; }
  cp -a "$image"/. "$WST_PREFIX"/
else
  make -C "$build" "$@"
fi
