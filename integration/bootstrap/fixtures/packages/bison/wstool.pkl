amends "modulepath:/package.pkl"

package { name = "bison"; version = "3.8.2" }

buildOptions {
  tool = "wstool-autotools"
  buildImage = "bootstrap"
  dockerImage = "ubuntu:24.04"
  buildEnvironment {
    ["WST_MAKE_SUBDIRS"] = "po runtime-po gnulib-po ."
    ["WST_MAKEINFO"] = "true"
    ["AUTOMAKE"] = "true"
    ["WST_JOBS"] = "1"
    ["WST_CACHE_REVISION"] = "package-local-tools"
    ["WST_COPY_SOURCE"] = "true"
  }
}

buildDependencies {
  ["wstool-autotools"] = "1.0.0"
  ["m4"] = "1.4.19"
}

importOptions {
  archive = "https://ftp.gnu.org/gnu/bison/bison-3.8.2.tar.xz"
  checksum = "9bba0214ccf7f1079c5d59210045227bcf619519840ebfa80cd3849cff5a5bf2"
  license = "GPL-3.0-or-later"
}
