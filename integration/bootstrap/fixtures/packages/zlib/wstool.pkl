amends "modulepath:/package.pkl"

package { name = "zlib"; version = "1.3.1" }

buildOptions {
  tool = "wstool-autotools"
  buildImage = "declared"
}

buildDependencies {
  ["wstool-autotools"] = "1.0.0"
  ["glibc"] = "2.39"
}

importOptions {
  archive = "https://zlib.net/fossils/zlib-1.3.1.tar.gz"
  checksum = "9a93b2b7dfdac77ceba5a558a580e74667dd6fede4585b91eefb60f03b72df23"
  license = "Zlib"
}
