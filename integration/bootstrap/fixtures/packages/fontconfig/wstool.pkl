amends "modulepath:/package.pkl"

package { name = "fontconfig"; version = "2.15.0" }

buildOptions {
  tool = "wstool-autotools"
  buildImage = "declared"
}

buildDependencies {
  ["wstool-autotools"] = "1.0.0"
  ["glibc"] = "2.39"
  ["freetype"] = "2.13.3"
  ["expat"] = "2.6.4"
}

importOptions {
  archive = "https://www.freedesktop.org/software/fontconfig/release/fontconfig-2.15.0.tar.xz"
  checksum = "63a0658d0e06e0fa886106452b58ef04f21f58202ea02a94c39de0d3335d7c0e"
  license = "MIT"
}
