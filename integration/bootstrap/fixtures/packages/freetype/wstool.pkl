amends "modulepath:/package.pkl"

package { name = "freetype"; version = "2.13.3" }

buildOptions {
  tool = "wstool-autotools"
  buildImage = "declared"
  buildConfig {
    ["with-brotli"] = "no"
    ["with-png"] = "no"
  }
}

buildDependencies {
  ["wstool-autotools"] = "1.0.0"
  ["glibc"] = "2.39"
  ["zlib"] = "1.3.1"
}

importOptions {
  archive = "https://download.savannah.gnu.org/releases/freetype/freetype-2.13.3.tar.xz"
  checksum = "0550350666d427c74daeb85d5ac7bb353acba5f76956395995311a9c6f063289"
  license = "FTL"
}
