amends "package://pkl.konna.cloud/pkl/wstool@1.0.2#/package.pkl"

package { name = "make"; version = "4.4.1" }

buildOptions {
  tool = "wstool-autotools"
  buildImage = "bootstrap"
  buildEnvironment {
    ["WST_JOBS"] = "1"
    ["WST_COPY_SOURCE"] = "true"
  }
}

buildDependencies {
  ["wstool-autotools"] = "1.0.0"
}

importOptions {
  archive = "https://ftp.gnu.org/gnu/make/make-4.4.1.tar.gz"
  checksum = "dd16fb1d67bfab79a72f5e8390735c49e3e8e70b4945a15ab1f81ddb78658fb3"
  license = "GPL-3.0-or-later"
}
