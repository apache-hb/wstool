amends "package://pkl.konna.cloud/pkl/wstool@1.0.2#/package.pkl"

package { name = "autoconf"; version = "2.72" }

buildOptions {
  tool = "wstool-autotools"
  buildImage = "bootstrap"
  buildEnvironment {
    ["WST_CACHE_REVISION"] = "portable-tool-paths"
    ["WST_COPY_SOURCE"] = "true"
  }
}

buildDependencies {
  ["wstool-autotools"] = "1.0.0"
  ["m4"] = "1.4.19"
  ["perl"] = "5.40.0"
}

importOptions {
  archive = "https://ftp.gnu.org/gnu/autoconf/autoconf-2.72.tar.xz"
  checksum = "ba885c1319578d6c94d46e9b0dceb4014caafe2490e437a0dbca3f270a223f5a"
  license = "GPL-3.0-or-later"
}
