#!/bin/bash
set -euo pipefail

: "${WST_SRCDIR:?WST_SRCDIR is required}"
: "${WST_PRIVATE:?WST_PRIVATE is required}"
: "${WST_PREFIX:?WST_PREFIX is required}"

sysroot="$WST_PRIVATE/sysroot"
build="$WST_PRIVATE/build"
source="$WST_SRCDIR"
mkdir -p "$sysroot" "$build" "$WST_PREFIX"
export PATH="$sysroot/bin:$PATH"
export M4="${M4:-m4}"
export CC="$sysroot/bin/x86_64-linux-gnu-gcc --sysroot=$sysroot"
export AR="$sysroot/bin/x86_64-linux-gnu-ar"
export RANLIB="$sysroot/bin/x86_64-linux-gnu-ranlib"

if [ ! -f "$build/Makefile" ]; then
  cd "$build"
  libc_cv_slibdir=/usr/lib libc_cv_rtlddir=/usr/lib "$source/configure" \
    --prefix=/usr \
    --build=x86_64-linux-gnu \
    --host=x86_64-linux-gnu \
    --with-headers="$sysroot/usr/include" \
    --disable-werror \
    --disable-multilib \
    --enable-kernel=4.14
fi

if [ "$#" -eq 0 ]; then
  make -C "$build" -j"${WST_JOBS:-2}"
  make -C "$build" install_root="$WST_PREFIX" install
else
  make -C "$build" "$@"
fi
