amends "modulepath:/package.pkl"

package { name = "glibc"; version = "2.39" }

buildOptions {
  tool = "wstool-glibc"
  buildImage = "bootstrap"
  dockerImage = "ubuntu:24.04"
  buildEnvironment {
    ["M4"] = "m4"
    ["WST_COPY_SOURCE"] = "true"
  }
}

buildDependencies {
  ["gcc"] = "14.2.0"
  ["gawk"] = "5.3.0"
  ["linux-headers"] = "6.12.54"
}

importOptions {
  archive = "https://ftp.gnu.org/gnu/glibc/glibc-2.39.tar.xz"
  checksum = "f77bd47cf8170c57365ae7bf86696c118adb3b120d3259c64c502d3dc1e2d926"
  license = "LGPL-2.1-or-later"
}
