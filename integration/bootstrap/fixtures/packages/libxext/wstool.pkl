amends "modulepath:/package.pkl"

package { name = "libxext"; version = "1.3.6" }

buildOptions {
  tool = "wstool-autotools"
  buildEnvironment {
    ["WST_JOBS"] = "1"
  }
  buildImage = "declared"
}

buildDependencies {
  ["glibc"] = "2.39"
  ["libx11"] = "1.8.10"
}

importOptions {
  archive = "https://xorg.freedesktop.org/archive/individual/lib/libXext-1.3.6.tar.xz"
  checksum = "edb59fa23994e405fdc5b400afdf5820ae6160b94f35e3dc3da4457a16e89753"
  license = "MIT"
}
