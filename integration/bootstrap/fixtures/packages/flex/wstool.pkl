amends "modulepath:/package.pkl"

package { name = "flex"; version = "2.6.4" }

buildOptions {
  tool = "wstool-autotools"
  buildImage = "bootstrap"
  dockerImage = "ubuntu:24.04"
  buildEnvironment {
    ["WST_MAKE_SUBDIRS"] = "src"
    ["WST_MAKEINFO"] = "true"
    ["WST_JOBS"] = "1"
    ["M4"] = "m4"
    ["AUTOMAKE"] = "true"
  }
}

buildDependencies {
  ["m4"] = "1.4.19"
  ["bison"] = "3.8.2"
}

importOptions {
  archive = "https://github.com/westes/flex/releases/download/v2.6.4/flex-2.6.4.tar.gz"
  checksum = "e87aae032bf07c26f85ac0ed3250998c37621d95f8bd748b31f15b33c45ee995"
  license = "BSD-2-Clause"
}
