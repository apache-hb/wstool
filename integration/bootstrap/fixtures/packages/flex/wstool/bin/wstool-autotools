#!/bin/bash
set -euo pipefail

: "${WST_SRCDIR:?WST_SRCDIR is required}"
: "${WST_PRIVATE:?WST_PRIVATE is required}"
: "${WST_PREFIX:?WST_PREFIX is required}"

sysroot="$WST_PRIVATE/sysroot"
build="$WST_PRIVATE/build"
source="$WST_PRIVATE/source"
mkdir -p "$sysroot" "$build" "$WST_PREFIX"

if [ ! -f "$sysroot/include/linux/limits.h" ]; then
  mkdir -p "$sysroot/include"
  cp -a /usr/include/linux "$sysroot/include/"
  cp -a /usr/include/asm-generic "$sysroot/include/"
  cp -a /usr/include/x86_64-linux-gnu/asm "$sysroot/include/"
fi
if [ ! -f "$sysroot/include/X11/X.h" ] && [ -d /usr/include/X11 ]; then
  mkdir -p "$sysroot/include"
  cp -a /usr/include/X11 "$sysroot/include/"
fi
if [ ! -f "$sysroot/include/xcb/xcb.h" ] && [ -d /usr/include/xcb ]; then
  mkdir -p "$sysroot/include"
  cp -a /usr/include/xcb "$sysroot/include/"
fi
for library in /usr/lib/x86_64-linux-gnu/libxcb.so* \
  /usr/lib/x86_64-linux-gnu/libXau.so* \
  /usr/lib/x86_64-linux-gnu/libXdmcp.so*; do
  if [ -e "$library" ]; then
    mkdir -p "$sysroot/lib"
    cp -a "$library" "$sysroot/lib/"
  fi
done
mkdir -p "$sysroot/usr"
if [ ! -e "$sysroot/usr/include" ]; then
  ln -s ../include "$sysroot/usr/include"
fi

if [ ! -f "$source/.wstool-source-ready" ]; then
  mkdir -p "$source"
  cp -a "$WST_SRCDIR"/. "$source"/
  rm -f "$source/builddir"
  rm -rf "$source/.git"
  touch "$source/.wstool-source-ready"
fi

if [ ! -x "$source/configure" ] && [ -x "$source/autogen.sh" ]; then
  (cd "$source" && ./autogen.sh)
elif [ ! -x "$source/configure" ] && [ -f "$source/configure.ac" ]; then
  (cd "$source" && autoreconf --force --install)
fi

export PATH="$sysroot/bin:$PATH"
export PKG_CONFIG_PATH="$sysroot/lib/pkgconfig:$sysroot/share/pkgconfig"
if [ -e "$sysroot/lib/ld-linux-x86-64.so.2" ]; then
  mkdir -p /lib64
  if [ ! -e /lib64/ld-linux-x86-64.so.2 ]; then
    ln -s "$sysroot/lib/ld-linux-x86-64.so.2" /lib64/ld-linux-x86-64.so.2
  fi
fi
if [ -e "$sysroot/lib/libc.so.6" ] && [ -x "$sysroot/bin/x86_64-linux-gnu-gcc" ]; then
  for compiler in gcc cc; do
    rm -f "$sysroot/bin/$compiler"
    cat > "$sysroot/bin/$compiler" <<'EOF'
#!/bin/sh
compiler_dir="$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)"
exec "$compiler_dir/x86_64-linux-gnu-gcc" --sysroot="$compiler_dir/.." "$@"
EOF
    chmod +x "$sysroot/bin/$compiler"
  done
  rm -f "$sysroot/bin/g++"
  cat > "$sysroot/bin/g++" <<'EOF'
#!/bin/sh
compiler_dir="$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)"
exec "$compiler_dir/x86_64-linux-gnu-g++" --sysroot="$compiler_dir/.." "$@"
EOF
  chmod +x "$sysroot/bin/g++"
fi
export CPPFLAGS="-I$sysroot/include ${CPPFLAGS:-}"
export LDFLAGS="-L$sysroot/lib ${LDFLAGS:-}"
export CFLAGS="-I$sysroot/include ${CFLAGS:-}"
export CXXFLAGS="-I$sysroot/include ${CXXFLAGS:-}"
export AUTOMAKE="${AUTOMAKE:-true}"
export CC="${CC:-gcc}"
export CXX="${CXX:-g++}"
export CFLAGS="--sysroot=$sysroot -I$sysroot/include ${CFLAGS:-}"
export CXXFLAGS="--sysroot=$sysroot -I$sysroot/include ${CXXFLAGS:-}"
if [ ! -e "$sysroot/bin/aclocal-1.17" ] && command -v aclocal >/dev/null 2>&1; then
  mkdir -p "$sysroot/bin"
  cat > "$sysroot/bin/aclocal-1.17" <<'EOF'
#!/bin/sh
unset AUTOMAKE_UNINSTALLED
exec /usr/bin/aclocal "$@"
EOF
  chmod +x "$sysroot/bin/aclocal-1.17"
fi
if [ ! -e "$sysroot/bin/automake-1.17" ] && command -v automake >/dev/null 2>&1; then
  mkdir -p "$sysroot/bin"
  cat > "$sysroot/bin/automake-1.17" <<'EOF'
#!/bin/sh
unset AUTOMAKE_UNINSTALLED
exec /usr/bin/automake "$@"
EOF
  chmod +x "$sysroot/bin/automake-1.17"
fi

if [ ! -e "$sysroot/lib/libc.so.6" ] && [ ! -e "$sysroot/lib64/libc.so.6" ]; then
  export WST_USE_HOST_COMPILER=true
fi

if [ "${WST_USE_HOST_COMPILER:-}" = "true" ]; then
  export CC="${WST_HOST_CC:-/usr/bin/gcc}"
  export CXX="${WST_HOST_CXX:-/usr/bin/g++}"
  export AR="${WST_HOST_AR:-/usr/bin/ar}"
  export RANLIB="${WST_HOST_RANLIB:-/usr/bin/ranlib}"
  export CPPFLAGS="-I$sysroot/include ${WST_HOST_CPPFLAGS:-}"
  export LDFLAGS="-L$sysroot/lib ${WST_HOST_LDFLAGS:-}"
  export CFLAGS="-I$sysroot/include ${WST_HOST_CFLAGS:-}"
  export CXXFLAGS="-I$sysroot/include ${WST_HOST_CXXFLAGS:-}"
fi

# Imported archives are immutable in the build container.  Preserve the
# generated files shipped in them and pass this policy to recursive makes.
while IFS= read -r old_file; do
  MAKEFLAGS="${MAKEFLAGS:-} -o $old_file"
done < <(find "$source" -type f \( -name configure -o -name Makefile.in -o -name '*.in' \) -print)
if [ -f "$source/aclocal.m4" ]; then
  MAKEFLAGS="${MAKEFLAGS:-} -o $source/aclocal.m4"
fi
export MAKEFLAGS

configure_options=()
while IFS='=' read -r name value; do
  if [ -n "$name" ]; then
    if [ -n "$value" ]; then
      configure_options+=("--$name=$value")
    else
      configure_options+=("--$name")
    fi
  fi
done <<< "${WST_USER_OPTIONS:-}"

if [ ! -f "$build/Makefile" ]; then
  cd "$build"
  "$source/configure" --prefix="$WST_PREFIX" "${configure_options[@]}"
fi
mkdir -p "$build/t"

if [ "$#" -eq 0 ]; then
  make_options=()
  make_options+=("-o" "$WST_SRCDIR/configure" "-o" "$WST_SRCDIR/Makefile.in")
  make_options+=("-o" "$source/configure" "-o" "$source/Makefile.in" "-o" "$source/aclocal.m4")
  if [ -n "${WST_MAKE_SUBDIRS:-}" ]; then
    make_options+=("SUBDIRS=$WST_MAKE_SUBDIRS")
  fi
  if [ -n "${WST_MAKE_SKIP_SUBDIRS:-}" ]; then
    while IFS= read -r variable; do
      value=$(sed -n "s/^$variable[[:space:]]*=[[:space:]]*//p" "$build/Makefile")
      for skipped in $WST_MAKE_SKIP_SUBDIRS; do
        if [[ " $value " == *" $skipped "* ]]; then
          make_options+=("$variable=")
          break
        fi
      done
    done < <(sed -nE 's/^(am__append_[0-9]+)[[:space:]]*=.*/\1/p' "$build/Makefile")
  fi
  if [ -n "${WST_MAKEINFO:-}" ]; then
    make_options+=("MAKEINFO=$WST_MAKEINFO")
  fi
  if [ -n "${WST_MAKE_PREPARE_TARGET:-}" ]; then
    read -r -a prepare_targets <<< "$WST_MAKE_PREPARE_TARGET"
    make -C "$build" "${make_options[@]}" "${prepare_targets[@]}"
  fi
  read -r -a make_targets <<< "${WST_MAKE_TARGET:-all}"
  make -C "$build" -j"${WST_JOBS:-2}" "${make_options[@]}" "${make_targets[@]}"
  if [ "${WST_SKIP_INSTALL:-}" != "true" ]; then
    make -C "$build" "${make_options[@]}" install
  fi
else
  make -C "$build" -o "$WST_SRCDIR/configure" -o "$WST_SRCDIR/Makefile.in" \
    -o "$source/configure" -o "$source/Makefile.in" -o "$source/aclocal.m4" "$@"
fi

if [ -n "${WST_COPY_BIN:-}" ]; then
  mkdir -p "$WST_PREFIX/bin"
  read -r -a copy_bins <<< "$WST_COPY_BIN"
  for binary in "${copy_bins[@]}"; do
    found=$(find "$build" "$source" -type f -name "$binary" -print -quit)
    cp "$found" "$WST_PREFIX/bin/$binary"
  done
fi

if [ -d "$WST_PREFIX/bin" ]; then
  while IFS= read -r installed_file; do
    if grep -Iq . "$installed_file"; then
      sed -i -E \
        -e '1s|^#!.*sysroot/bin/perl$|#!/usr/bin/env perl|' \
        -e 's|/workspace/\.wstool/build/[^/]*/sysroot/bin/([[:alnum:]_.+-]+)|\1|g' \
        "$installed_file"
    fi
  done < <(find "$WST_PREFIX/bin" -type f -print)
fi
