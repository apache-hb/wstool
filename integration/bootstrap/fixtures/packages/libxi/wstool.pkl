amends "package://pkl.konna.cloud/pkl/wstool@1.0.2#/package.pkl"

package { name = "libxi"; version = "1.8.2" }

buildOptions {
  tool = "wstool-autotools"
  buildEnvironment {
    ["WST_JOBS"] = "1"
    ["WST_USE_HOST_COMPILER"] = "true"
  }
  buildImage = "declared"
}

buildDependencies {
  ["wstool-autotools"] = "1.0.0"
  ["glibc"] = "2.39"
  ["libx11"] = "1.8.10"
  ["libxext"] = "1.3.6"
}

importOptions {
  archive = "https://xorg.freedesktop.org/archive/individual/lib/libXi-1.8.2.tar.xz"
  checksum = "d0e0555e53d6e2114eabfa44226ba162d2708501a25e18d99cfb35c094c6c104"
  license = "MIT"
}
