amends "package://pkl.konna.cloud/pkl/wstool@1.0.2#/package.pkl"

package { name = "gcc"; version = "14.2.0" }

buildOptions {
  tool = "wstool-gcc"
  buildImage = "bootstrap"
}

buildDependencies {
  ["binutils"] = "2.43.1"
  ["gmp"] = "6.3.0"
  ["mpfr"] = "4.2.1"
  ["mpc"] = "1.3.1"
  ["isl"] = "0.26"
}

importOptions {
  archive = "https://ftp.gnu.org/gnu/gcc/gcc-14.2.0/gcc-14.2.0.tar.xz"
  checksum = "a7b39bc69cbf9e25826c5a60ab26477001f7c08d85cec04bc0e29cabed6f3cc9"
  license = "GPL-3.0-or-later"
}
