#!/bin/bash
set -euo pipefail

: "${WST_SRCDIR:?WST_SRCDIR is required}"
: "${WST_PRIVATE:?WST_PRIVATE is required}"
: "${WST_PREFIX:?WST_PREFIX is required}"

sysroot="$WST_PRIVATE/sysroot"
build="$WST_PRIVATE/build"
wstool sysroot build --output "$sysroot"
mkdir -p "$build" "$WST_PREFIX"
export PATH="$sysroot/bin:$PATH"

if [ ! -f "$build/Makefile" ]; then
  cd "$build"
  "$WST_SRCDIR/configure" \
    --prefix="$WST_PREFIX" \
    --target=x86_64-linux-gnu \
    --with-sysroot="$sysroot" \
    --with-gmp="$sysroot" \
    --with-mpfr="$sysroot" \
    --with-mpc="$sysroot" \
    --with-isl="$sysroot" \
    --with-newlib \
    --without-headers \
    --disable-threads \
    --disable-shared \
    --disable-nls \
    --disable-multilib \
    --disable-bootstrap \
    --disable-libssp \
    --disable-libquadmath \
    --disable-libgomp \
    --enable-languages=c,c++
fi

if [ "$#" -eq 0 ]; then
  make -C "$build" -j"${WST_JOBS:-2}" all-gcc all-target-libgcc
  make -C "$build" install-gcc install-target-libgcc
else
  make -C "$build" "$@"
fi
