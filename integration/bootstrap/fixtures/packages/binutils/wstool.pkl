amends "modulepath:/package.pkl"

package { name = "binutils"; version = "2.43.1" }

buildOptions {
  tool = "wstool-binutils"
  buildImage = "bootstrap"
  dockerImage = "ubuntu:24.04"
  buildEnvironment { ["WST_MAKEINFO"] = "true" }
}

buildDependencies {
  ["m4"] = "1.4.19"
  ["bison"] = "3.8.2"
  ["flex"] = "2.6.4"
}

importOptions {
  archive = "https://ftp.gnu.org/gnu/binutils/binutils-2.43.1.tar.xz"
  checksum = "13f74202a3c4c51118b797a39ea4200d3f6cfbe224da6d1d95bb938480132dfd"
  license = "GPL-3.0-or-later"
}
