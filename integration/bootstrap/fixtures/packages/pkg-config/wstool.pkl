amends "modulepath:/package.pkl"

package { name = "pkg-config"; version = "0.29.2" }

buildOptions {
  tool = "wstool-autotools"
  buildImage = "bootstrap"
  dockerImage = "ubuntu:24.04"
  buildConfig { ["with-internal-glib"] = "yes" }
}

importOptions {
  archive = "https://pkg-config.freedesktop.org/releases/pkg-config-0.29.2.tar.gz"
  checksum = "6fc69c01688c9458a57eb9a1664c9aba372ccda420a02bf4429fe610e7e7d591"
  license = "GPL-2.0-or-later"
}
