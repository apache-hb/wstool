amends "package://pkl.konna.cloud/pkl/wstool@1.0.2#/package.pkl"

package { name = "automake"; version = "1.17" }

buildOptions {
  tool = "wstool-autotools"
  buildImage = "bootstrap"
  buildEnvironment {
    ["WST_JOBS"] = "1"
    ["WST_COPY_SOURCE"] = "true"
  }
}

buildDependencies {
  ["wstool-autotools"] = "1.0.0"
  ["autoconf"] = "2.72"
  ["make"] = "4.4.1"
}

importOptions {
  archive = "https://ftp.gnu.org/gnu/automake/automake-1.17.tar.xz"
  checksum = "8920c1fc411e13b90bf704ef9db6f29d540e76d232cb3b2c9f4dc4cc599bd990"
  license = "GPL-2.0-or-later"
}
