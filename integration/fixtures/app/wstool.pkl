amends "modulepath:/package.pkl"

package {
  name = "sample-app"
  version = "1.0.0"
}

buildTool = "wstool-cmake"

buildOptions {
  networkIsolation = "isolated"
  sourceMount = "readonly"
  buildImage = "declared"
}

buildDependencies {
  ["wstool-cmake"] = "1.0.0"
}

dependencies {
  ["abseil"] = "20240116.2"
  ["glibc"] = "2.39"
}

testDependencies {
  ["googletest"] = "1.14.0"
}
