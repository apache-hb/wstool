amends "modulepath:/package.pkl"

package {
  name = "sample-app"
  version = "1.0.0"
}

buildOptions {
  tool = "wstool-cmake"
  networkIsolation = "isolated"
  sourceMount = "readonly"
  buildImage = "declared"
  buildEnvironment {
    ["CMAKE_BUILD_PARALLEL_LEVEL"] = "2"
  }
  buildConfig {
    ["CMAKE_BUILD_TYPE"] = "Release"
  }
}

buildDependencies {
  ["wstool-cmake"] = "1.0.0"
}

dependencies {
  ["abseil"] = "20240116.2"
  ["glibc"] = "2.39"
}

testDependencies {
  ["googletest"] = "1.14.0"
}
