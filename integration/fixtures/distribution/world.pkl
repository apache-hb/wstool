amends "modulepath:/distribution.pkl"

import "modulepath:/distribution.pkl"

name = "demo"

local gitServer = "__GIT_SERVER__"

storage {
  bucket = "storage"
}

packages {
  ["wstool-cmake@1.0.0"] = new distribution.GitRepository {
    repo = "\(gitServer)/wstool-cmake.git"
  }
  ["abseil@20240116.2"] = new distribution.GitRepository {
    repo = "\(gitServer)/abseil.git"
  }
  ["googletest@1.14.0"] = new distribution.GitRepository {
    repo = "\(gitServer)/googletest.git"
  }
  ["glibc@2.39"] = new distribution.GitRepository {
    repo = "\(gitServer)/glibc.git"
  }
  ["sample-app@1.0.0"] = new distribution.GitRepository {
    repo = "\(gitServer)/sample-app.git"
  }
}
