amends "package://pkl.konna.cloud/pkl/wstool@1.0.2#/package.pkl"

package {
  name = "glibc"
  version = "2.39"
}

buildOptions {
  tool = "wstool-glibc"
  buildEnvironment {
    ["MAKEFLAGS"] = "-j2"
  }
}

importOptions {
  archive = "https://ftp.gnu.org/gnu/glibc/glibc-2.39.tar.xz"
  checksum = "f77bd47cf8170c57365ae7bf86696c118adb3b120d3259c64c502d3dc1e2d926"
  license = "LGPL-2.1-or-later"
}
