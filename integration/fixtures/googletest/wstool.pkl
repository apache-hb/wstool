amends "package://pkl.konna.cloud/pkl/wstool@1.0.2#/package.pkl"

package {
  name = "googletest"
  version = "1.14.0"
}

buildOptions {
  tool = "wstool-cmake"
  buildEnvironment {
    ["CMAKE_BUILD_PARALLEL_LEVEL"] = "2"
  }
  buildConfig {
    ["CMAKE_BUILD_TYPE"] = "Release"
    ["INSTALL_GTEST"] = "ON"
  }
}

buildDependencies {
  ["wstool-cmake"] = "1.0.0"
}

importOptions {
  archive = "https://github.com/google/googletest/archive/refs/tags/v1.14.0.tar.gz"
  checksum = "8ad598c73ad796e0d8280b082cebd82a630d73e73cd3c70057938a6501bba5d7"
  license = "BSD-3-Clause"
}
