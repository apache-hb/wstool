amends "modulepath:/package.pkl"

package {
  name = "abseil"
  version = "20240116.2"
}

buildOptions {
  tool = "wstool-cmake"
  buildEnvironment {
    ["CMAKE_BUILD_PARALLEL_LEVEL"] = "2"
  }
  buildConfig {
    ["CMAKE_BUILD_TYPE"] = "Release"
    ["ABSL_ENABLE_INSTALL"] = "ON"
  }
}

buildDependencies {
  ["wstool-cmake"] = "1.0.0"
}

importOptions {
  archive = "https://github.com/abseil/abseil-cpp/archive/refs/tags/20240116.2.tar.gz"
  checksum = "733726b8c3a6d39a4120d7e45ea8b41a434cdacde401cba500f14236c49b39dc"
  license = "Apache-2.0"
}
