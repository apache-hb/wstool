amends "package://pkl.konna.cloud/pkl/wstool@1.0.0#/package.pkl"

package { name = "gcc"; version = "14.2.0" }
buildOptions { tool = "wstool-gcc"; dockerImage = read("env:WST_BUILD_IMAGE") }

buildDependencies {
  ["binutils"] = "2.43.1"
  ["gmp"] = "6.3.0"
  ["mpfr"] = "4.2.1"
  ["mpc"] = "1.3.1"
  ["isl"] = "0.26"
  ["wstool-cli"] = "0.1.0"
}
