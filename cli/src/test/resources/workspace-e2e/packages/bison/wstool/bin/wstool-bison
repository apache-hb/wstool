#!/usr/bin/env bash
set -euo pipefail
source_dir="$WST_SRCDIR/source"
build_dir="$WST_PRIVATE/build"
sysroot="$WST_PRIVATE/sysroot"
wstool sysroot "(closure build)" --output "$sysroot"
test -x "$sysroot/bin/m4"
export PATH="$sysroot/bin:$PATH"
mkdir -p "$build_dir"
cd "$build_dir"
"$source_dir/configure" --prefix="$WST_PREFIX" --disable-nls
make -j32
make install
