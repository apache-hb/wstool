#!/usr/bin/env bash
set -euo pipefail

source_dir="$WST_SRCDIR/source"
"$source_dir/bootstrap" \
  --prefix="$WST_PREFIX" \
  --parallel=32 \
  --no-system-libs \
  --system-zlib \
  --system-expat \
  -- \
  -DBUILD_TESTING=OFF \
  -DBUILD_CursesDialog=OFF \
  -DCMAKE_USE_OPENSSL=OFF \
  -DCMAKE_PREFIX_PATH="$WST_SYSROOT" \
  -DZLIB_USE_STATIC_LIBS=ON \
  -DZLIB_INCLUDE_DIR="$WST_SYSROOT/include" \
  -DZLIB_LIBRARY_RELEASE="$WST_SYSROOT/lib/libz.a" \
  -DEXPAT_INCLUDE_DIR="$WST_SYSROOT/include" \
  -DEXPAT_LIBRARY_RELEASE="$WST_SYSROOT/lib/libexpat.a"
make -C "$WST_SRCDIR" -j32
make -C "$WST_SRCDIR" install
