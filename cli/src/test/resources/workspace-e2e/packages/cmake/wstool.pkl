amends "package://pkl.konna.cloud/pkl/wstool@1.0.1#/package.pkl"

package { name = "cmake"; version = "3.30.5" }
buildOptions {
  tool = "wstool-cmake"
  dockerImage = read("env:WST_BUILD_IMAGE")
  sourceMount = "readwrite"
}
buildDependencies {
  ["zlib"] = "1.3.1"
  ["expat"] = "2.6.4"
  ["wstool-cli"] = "0.1.0"
}
dependencies {
  ["zlib"] = "1.3.1"
  ["expat"] = "2.6.4"
}
