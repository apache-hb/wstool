#!/usr/bin/env bash
set -euo pipefail
source_dir="$WST_SRCDIR/source"
build_dir="$WST_PRIVATE/build"
sysroot="$WST_PRIVATE/sysroot"
wstool sysroot build --output "$sysroot"
test -x "$sysroot/bin/m4"
test -x "$sysroot/bin/bison"
test -x "$sysroot/bin/flex"
export PATH="$sysroot/bin:$PATH"
mkdir -p "$build_dir"
cd "$build_dir"
if [[ ! -f Makefile ]]; then
  "$source_dir/configure" --prefix="$WST_PREFIX" --target=x86_64-linux-gnu --disable-nls --disable-werror --disable-gdb --disable-gdbserver --disable-sim --disable-readline
fi
if [[ "${1:-release}" == release ]]; then
  make -j32 MAKEINFO=true all-binutils all-gas all-ld
  make MAKEINFO=true install-binutils install-gas install-ld
else
  make -j32 "$@"
fi
