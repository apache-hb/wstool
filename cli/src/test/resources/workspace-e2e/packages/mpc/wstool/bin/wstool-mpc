#!/usr/bin/env bash
set -euo pipefail
source_dir="$WST_SRCDIR/source"
build_dir="$WST_PRIVATE/build"
sysroot="$WST_PRIVATE/sysroot"
wstool sysroot "(closure build)" --output "$sysroot"
test -f "$sysroot/include/gmp.h"
test -f "$sysroot/include/mpfr.h"
mkdir -p "$build_dir"
cd "$build_dir"
"$source_dir/configure" --prefix="$WST_PREFIX" --with-gmp="$sysroot" --with-mpfr="$sysroot" --disable-shared --enable-static
make -j32
make install
