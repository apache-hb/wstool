amends "package://pkl.konna.cloud/pkl/wstool@1.0.0#/package.pkl"

package { name = "gradle-smoke"; version = "1.0.0" }

buildOptions {
  tool = "wstool-gradle"
  dockerImage = read("env:WST_BUILD_IMAGE")
  sourceMount = "readwrite"
}

buildDependencies {
  ["local-artifact"] = "1.0.0"
  ["wstool-gradle"] = "1.0.0"
}
