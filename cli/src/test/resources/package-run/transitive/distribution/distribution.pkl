amends "package://pkl.konna.cloud/pkl/wstool@1.0.2#/distribution.pkl"

local appRepository = read("env:TRANSITIVE_APP_REPOSITORY")
local ownerRepository = read("env:TOOL_OWNER_REPOSITORY")
local helperRepository = read("env:TOOL_HELPER_REPOSITORY")

platforms { "ubuntu:24.04" }

storage { bucket = "unused-test-bucket" }

packages {
  new GitRepository {
    name = "transitive-app"
    version = "1.0.0"
    repo = appRepository
    branch = "master"
  }
  new GitRepository {
    name = "tool-owner"
    version = "1.0.0"
    repo = ownerRepository
    branch = "master"
  }
  new GitRepository {
    name = "tool-helper"
    version = "1.0.0"
    repo = helperRepository
    branch = "master"
  }
}
