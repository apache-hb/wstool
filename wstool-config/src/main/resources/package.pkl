open module wstool.package

typealias Version = String
typealias DependencyMap = Mapping<String, Version>

typealias NetworkIsolation = "isolated" | "open"

/// The mount type of the packages source code inside the build container
/// "readonly" mounts the source code as readonly, this is recommended as it means builds don't modify their own source tree
/// "readwrite" mounts the source code as readwrite, this should only be used with external packages that have janky build systems or
/// lack out of tree build support
typealias SourceMount = "readonly" | "readwrite"

class WsToolPackage {
  /// The name of this package
  name: String(isNotEmpty)

  /// The major version of this package
  version: Version(isNotEmpty)
}

class BuildOptions {
  /// The name of the build tool to use, this is the name of a script either in the wstool/bin local directory
  /// or provided by a buildDependency in its own bin folder.
  tool: String(isNotEmpty)

  /// The network isolation mode to use for the build, isolated network is recommended to
  /// prevent builds from being non-deterministic
  networkIsolation: NetworkIsolation = "isolated"

  /// The mount type of the packages source code inside the build container
  /// Prefer readonly mounts as it means builds don't modify their own source tree
  sourceMount: SourceMount = "readonly"
}

/// External source code of some description
abstract class CodeSource {
  /// Patches to apply to this code source before building.
  /// These are applied using `patch`
  patches: Listing<Uri> = new Listing {}

  /// SPDX license string for this code, must be provided
  license: String(isNotEmpty)
}

local const function isNotNegative() = (v) -> (v >= 0)
local const function isSha256() = (v) -> v.matches(Regex("^[a-fA-F0-9]{64}$"))

class ArchiveSource extends CodeSource {
  /// Location of the archive
  uri: Uri

  /// sha256 checksum of the archive
  checksum: String(isSha256())

  /// Strip leading folders
  stripComponents: Int(isNotNegative()) = 0
}

class FileSource extends CodeSource {
  /// Location of the file
  uri: Uri

  /// Local path to write to the file to when building
  path: String

  /// sha256 checksum of the file
  checksum: String(isSha256())
}

class ImportOptions {
  sources: Listing<CodeSource> = new Listing {}
}

/// Package metadata
package: WsToolPackage

/// Build options
build: BuildOptions

/// External import options
externalSources: ImportOptions?

/// Dependencies only required during build time, such as gradle or cmake
buildDependencies: DependencyMap?

/// Dependencies that are part of the public api
dependencies: DependencyMap?

/// Dependencies that are required to build and test, but not required at runtime
testDependencies: DependencyMap?

/// Dependencies that are required at runtime, but are not part of the public api
runtimeDependencies: DependencyMap?

/// Override dependency versions if a dependency has 2 conflicting versions
overrideDependencies: DependencyMap?
