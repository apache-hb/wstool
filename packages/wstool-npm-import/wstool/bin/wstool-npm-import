#!/usr/bin/env node
'use strict';

const fs = require('node:fs');
const path = require('node:path');

const source = required('WST_SRCDIR');
const prefix = required('WST_PREFIX');
const toolScript = path.join(source, 'wstool', 'bin', 'wstool-npm-import');

if (fs.existsSync(toolScript)) {
  const destination = path.join(prefix, 'bin', 'wstool-npm-import');
  fs.mkdirSync(path.dirname(destination), { recursive: true });
  fs.copyFileSync(toolScript, destination);
  fs.chmodSync(destination, 0o755);
} else {
  installImportedPackage();
}

function installImportedPackage() {
  const sourceTarball = path.join(source, 'package.tgz');
  if (!fs.existsSync(sourceTarball) || !fs.statSync(sourceTarball).isFile()) {
    throw new Error(`Imported npm package has no tarball at ${sourceTarball}`);
  }
  const destination = path.join(prefix, 'share', 'wstool-npm', 'package.tgz');
  fs.mkdirSync(path.dirname(destination), { recursive: true });
  fs.copyFileSync(sourceTarball, destination);
}

function required(name) {
  if (!process.env[name]) throw new Error(`${name} is required`);
  return process.env[name];
}
