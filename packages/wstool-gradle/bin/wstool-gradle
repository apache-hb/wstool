#!/bin/sh
set -eu

: "${WST_SRCDIR:?WST_SRCDIR is required}"
: "${WST_PRIVATE:?WST_PRIVATE is required}"

sysroot="$WST_PRIVATE/sysroot"
gradle_user_home="$WST_PRIVATE/gradle-user-home"
mkdir -p "$gradle_user_home"
export GRADLE_USER_HOME="$gradle_user_home"
"${WSTOOL:-wstool}" sysroot build --output "$sysroot"
export WST_MAVEN_REPOSITORY="$sysroot/share/maven-repo"
export WST_GRADLE_PLUGIN_JAR="$sysroot/share/wstool-gradle/wstool-gradle-plugin.jar"

if [ ! -d "$WST_MAVEN_REPOSITORY" ]; then
  echo "wstool Maven repository is missing from the build sysroot." >&2
  exit 1
fi
if [ ! -f "$WST_GRADLE_PLUGIN_JAR" ]; then
  echo "wstool Gradle plugin is missing from the build sysroot." >&2
  exit 1
fi
gradle_bin="$sysroot/share/gradle/bin/gradle"
if [ ! -x "$gradle_bin" ]; then
  echo "Gradle executable is missing from the gradle package: $gradle_bin" >&2
  exit 1
fi

if [ "$#" -eq 0 ] || [ "$1" = "release" ]; then
  set -- build
fi
"$gradle_bin" --offline --no-daemon --init-script \
  "$sysroot/share/wstool-gradle/init.gradle" "$@"
