#!/bin/sh
set -eu

: "${WST_SRCDIR:?WST_SRCDIR is required}"
: "${WST_PREFIX:?WST_PREFIX is required}"

source_repository="$WST_SRCDIR/repository"
output_repository="$WST_PREFIX/share/maven-repo"
if [ -d "$WST_SRCDIR/lib" ]; then
  mkdir -p "$WST_PREFIX/share/maven-artifacts"
  cp -a "$WST_SRCDIR/lib"/. "$WST_PREFIX/share/maven-artifacts"/
  exit 0
fi

if [ ! -d "$source_repository" ]; then
  source_tool="$WST_SRCDIR/wstool/bin/maven-wstool-import"
  if [ ! -f "$source_tool" ]; then
    echo "Shared Maven build tool is missing from package source: $source_tool" >&2
    exit 1
  fi
  mkdir -p "$WST_PREFIX/bin"
  cp "$source_tool" "$WST_PREFIX/bin/maven-wstool-import"
  chmod +x "$WST_PREFIX/bin/maven-wstool-import"
  exit 0
fi

mkdir -p "$output_repository" "$WST_PREFIX/share/javadoc"
cp -a "$source_repository"/. "$output_repository"/
find "$source_repository" -type f -name '*-javadoc.jar' |
  while IFS= read -r javadoc; do
    relative=${javadoc#"$source_repository"/}
    destination="$WST_PREFIX/share/javadoc/${relative%-javadoc.jar}"
    mkdir -p "$(dirname "$destination")"
    cp "$javadoc" "$destination.jar"
  done
