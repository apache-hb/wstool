#!/bin/sh
set -eu

: "${WST_SRCDIR:?WST_SRCDIR is required}"
: "${WST_PRIVATE:?WST_PRIVATE is required}"
: "${WST_PREFIX:?WST_PREFIX is required}"

source=$WST_SRCDIR
build=$WST_PRIVATE
install=$WST_PREFIX
sysroot=$build/sysroot
workspace_sysroot=$(dirname "$(dirname "$build")")/sysroot
mkdir -p "$sysroot"
if [ -d "$workspace_sysroot" ]; then
  cp -a "$workspace_sysroot"/. "$sysroot"/
fi

if [ "$#" -eq 0 ]; then
  set --
  if [ -n "${WST_USER_OPTIONS:-}" ]; then
    old_ifs=$IFS
    IFS='
'
    for option in $WST_USER_OPTIONS; do
      [ -n "$option" ] && set -- "$@" "-D$option"
    done
    IFS=$old_ifs
  fi
  cmake \
    -S "$source" \
    -B "$build" \
    -DCMAKE_INSTALL_PREFIX="$install" \
    -DCMAKE_PREFIX_PATH="$sysroot" \
    "$@"
  cmake --build "$build" --parallel
  cmake --install "$build"
  if [ -f "$build/CTestTestfile.cmake" ]; then
    ctest --test-dir "$build" --output-on-failure
  fi
  exit 0
fi

target=$1
shift
case "$target" in
  test)
    ctest --test-dir "$build" --output-on-failure "$@"
    ;;
  *)
    cmake --build "$build" --target "$target" -- "$@"
    ;;
esac
