#!/bin/sh
set -eu

: "${WST_SRCDIR:?WST_SRCDIR is required}"
: "${WST_PRIVATE:?WST_PRIVATE is required}"
: "${WST_PREFIX:?WST_PREFIX is required}"

source=$WST_SRCDIR
build=$WST_PRIVATE
install=$WST_PREFIX
sysroot=$build/sysroot
mkdir -p "$sysroot"
export PATH="$sysroot/bin:$PATH"
if [ -x "$sysroot/bin/gcc" ]; then
  export CC="${CC:-$sysroot/bin/gcc}"
fi
if [ -x "$sysroot/bin/g++" ]; then
  export CXX="${CXX:-$sysroot/bin/g++}"
fi
export PKG_CONFIG_PATH="$sysroot/lib/pkgconfig:$sysroot/share/pkgconfig"

if [ "$#" -eq 0 ]; then
  meson setup \
    "$build" \
    "$source" \
    --prefix "$install" \
    --buildtype release \
    -Dc_args=-isystem"$sysroot/include" \
    -Dcpp_args=-isystem"$sysroot/include"
  meson compile -C "$build"
  meson install -C "$build"
  meson test -C "$build" --print-errorlogs
  exit 0
fi

target=$1
shift
case "$target" in
  test)
    meson test -C "$build" --print-errorlogs "$@"
    ;;
  *)
    meson compile -C "$build" "$target" "$@"
    ;;
esac
