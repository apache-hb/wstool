amends "package://pkl.konna.cloud/pkl/wstool@1.0.0#/distribution.pkl"

local git = read("env:GIT_ENDPOINT")

distribution {
    name = "simple"

    storage {
        endpoint = read("env:AWS_S3_ENDPOINT")
        bucket = read("env:STORAGE_BUCKET")
    }

    packages {
        new GitRepository {
            name = "root"
            version = "1.0"
            repo = "\(git)/root"
        }

        new GitRepository {
            name = "middle"
            version = "1.0"
            repo = "\(git)/middle"
        }

        new GitRepository {
            name = "upper"
            version = "1.0"
            repo = "\(git)/upper"
        }
    }
}
