amends "package://pkl.konna.cloud/pkl/wstool@1.0.0#/distribution.pkl"

distribution {
  name = "test"

  storage {
    bucket = "test-bucket"
  }

  packages {
    new GitRepository {
      name = "root"
      version = "1.0"
      repo = read("env:PACKAGE_GIT_REPOSITORY")
      branch = "main"
    }
  }
}
