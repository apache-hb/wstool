open module wstool.package

typealias Version = String
typealias DependencyMap = Mapping<String, Version>

typealias NetworkIsolation = "isolated" | "open"

/// The mount type of the packages source code inside the build container
/// "readonly" mounts the source code as readonly, this is recommended as it means builds don't modify their own source tree
/// "readwrite" mounts the source code as readwrite, this should only be used with external packages that have janky build systems or
/// lack out of tree build support
typealias SourceMount = "readonly" | "readwrite"

class WsToolPackage {
  name: String
  version: Version
}

class BuildOptions {
  tool: String

  /// Extra environment variables passed to the build tool
  buildEnvironment: Mapping<String, String>?

  /// A freeform map of options that are passed to the build tool through the environment variable `WST_USER_OPTIONS`
  buildConfig: Mapping<String, String>?

  networkIsolation: NetworkIsolation = "isolated"
  sourceMount: SourceMount = "readonly"
}

abstract class ExternalPackage {}

class ExternalFile {
  uri: Uri

  mirrors: Listing<Uri> = new Listing {}

  checksum: String
}

class ExternalFiles extends ExternalPackage {
  /// A list of files that will be copied into the package at the specified path, the path is relative to the root of the package
  /// These files will not be extracted, and are copied as is.
  files: Mapping<String, ExternalFile>
}

class ExternalArchive extends ExternalPackage {
  /// The uri of the compressed archive path the code is stored in
  archive: Uri

  /// A list of mirrors to use for downloading the archive, if the primary uri is unavailable
  mirrors: Listing<Uri> = new Listing {}

  // SHA-256 checksum of the compressed archive
  checksum: String
}

class ExternalGitRepository extends ExternalPackage {
  /// The uri of the git repository
  repo: Uri

  /// The branch to checkout, defaults to master
  branch: String = "master"
}

/// Options for 3rd party imports
class ImportOptions {
  /// Uri of the compressed archive path the code is stored in
  source: ExternalPackage

  /// The license of the code, should be a valid SPDX license identifier
  license: String

  /// Patches to apply to the source code after it has been extracted from the archive, but before it is built
  hidden patches: Listing<Resource> = new Listing {}

  patchContents: Listing<String> = new Listing {
    for (patch in patches) {
      patch.text
    }
  }
}

package: WsToolPackage

buildOptions: BuildOptions

importOptions: ImportOptions?

/// Dependencies only required during build time, such as gradle or cmake
buildDependencies: DependencyMap?

/// Dependencies that are part of the public api
dependencies: DependencyMap?

/// Dependencies that are required to build and test, but not required at runtime
testDependencies: DependencyMap?

/// Dependencies that are required at runtime, but are not part of the public api
runtimeDependencies: DependencyMap?

/// Override dependency versions if a dependency has 2 conflicting versions
overrideDependencies: DependencyMap?
