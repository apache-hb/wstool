open module wstool.distribution

abstract class PackageSource {}

/// A package that is stored as a source archive
class Archive extends PackageSource {
  /// Path to the archive, can be remote or on the local filesystem
  uri: Uri

  /// SHA-256 hash of the archive
  checksum: String
}

/// A package that is stored within the current repository
class SourceCode extends PackageSource {
  path: String
}

/// A package that is stored in a git repository
class GitRepository extends PackageSource {
  repo: Uri

  branch: String = "master"
}

class Storage {
  /// The endpoint to use for s3 api calls, defaults to aws s3
  endpoint: Uri?

  /// The bucket this distribution is stored in
  bucket: String
}

typealias NameVersion = String(matches(Regex("[A-Za-z0-9_.+-]+@[A-Za-z0-9_.+-]+")))

/// The name of this distribution
name: String

/// Storage options for this distribution
storage: Storage

/// A map of package names to the sources of those packages
packages: Mapping<NameVersion, PackageSource>
