open module wstool.distribution

typealias NameVersion = String(matches(Regex("[A-Za-z0-9_.+-]+@[A-Za-z0-9_.+-]+")))

abstract class PackageSource {
  /// The name of this package
  name: String(isNotEmpty)

  /// The major version of this package
  version: String
}

/// A package that is stored as a source archive
class Archive extends PackageSource {
  /// Path to the archive, can be remote or on the local filesystem
  uri: Uri

  /// SHA-256 hash of the archive
  checksum: String
}

local const function isNotRecursive() = (pkg) -> !(pkg is SourceCode)

/// A package that is stored within another package
class SourceCode extends PackageSource {
  from: PackageSource(isNotRecursive())

  path: String
}

/// A package that is stored in a git repository
class GitRepository extends PackageSource {
  repo: Uri

  branch: String = "master"
}

class Storage {
  /// The endpoint to use for s3 api calls, defaults to your regional aws s3 endpoint
  endpoint: Uri? = null

  /// The bucket this distribution is stored in
  bucket: String(isNotEmpty)
}

/// The name of this distribution
name: String

/// Storage options for this distribution
storage: Storage

local const function noDuplicatePackageMajorVersions() = (pkgs: Listing<PackageSource>) ->
  pkgs.toList().map((pkg) -> "\(pkg.name)-\(pkg.version)").isDistinct

/// A map of package names to the sources of those packages
packages: Listing<PackageSource>(noDuplicatePackageMajorVersions())
