amends "package://pkl.konna.cloud/pkl/wstool@1.0.2#/distribution.pkl"

local git = read("env:GIT_ENDPOINT")
local user = read("env:GIT_USERNAME")

name = "simple"

platforms { "ubuntu:24.04" }

storage {
  endpoint = read("env:AWS_S3_ENDPOINT")
  bucket = read("env:STORAGE_BUCKET")
}

packages {
  new GitRepository {
    name = "root"
    version = "1.0"
    repo = "\(git)/\(user)/root"
  }

  new GitRepository {
    name = "middle"
    version = "1.0"
    repo = "\(git)/\(user)/middle"
  }

  new GitRepository {
    name = "upper"
    version = "1.0"
    repo = "\(git)/\(user)/upper"
  }
}
