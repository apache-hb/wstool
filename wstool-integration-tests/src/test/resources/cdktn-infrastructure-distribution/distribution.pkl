amends "package://pkl.konna.cloud/pkl/wstool@1.0.2#/distribution.pkl"

local packageIndex = read("env:PACKAGE_INDEX_REPOSITORY")
local npmImport = read("env:WSTOOL_NPM_IMPORT_REPOSITORY")
local infrastructure = read("env:INFRASTRUCTURE_REPOSITORY")

platforms { "ubuntu:24.04" }

storage { bucket = "unused-test-bucket" }

packages {
  new Folder {
    name = "npm-wstool"
    version = "1.0.0"
    from = new GitRepository {
      name = "package-index"
      version = "1.0"
      repo = packageIndex
    }
    path = "packages/npm-wstool"
  }
  new GitRepository {
    name = "wstool-npm-import"
    version = "1.0.0"
    repo = npmImport
  }
  new Folder {
    name = "cdktn"
    version = "0.24.0"
    from = new GitRepository {
      name = "package-index"
      version = "1.0"
      repo = packageIndex
    }
    path = "npm/cdktn/0.24.0"
  }
  new Folder {
    name = "@cdktn/provider-local"
    version = "14.0.1"
    from = new GitRepository {
      name = "package-index"
      version = "1.0"
      repo = packageIndex
    }
    path = "npm/@cdktn/provider-local/14.0.1"
  }
  new Folder {
    name = "@cdktn/provider-random"
    version = "15.0.1"
    from = new GitRepository {
      name = "package-index"
      version = "1.0"
      repo = packageIndex
    }
    path = "npm/@cdktn/provider-random/15.0.1"
  }
  new Folder {
    name = "constructs"
    version = "10.7.2"
    from = new GitRepository {
      name = "package-index"
      version = "1.0"
      repo = packageIndex
    }
    path = "npm/constructs/10.7.2"
  }
  new Folder {
    name = "typescript"
    version = "5.9.3"
    from = new GitRepository {
      name = "package-index"
      version = "1.0"
      repo = packageIndex
    }
    path = "npm/typescript/5.9.3"
  }
  new GitRepository {
    name = "wstool-test-infrastructure"
    version = "1.0.0"
    repo = infrastructure
  }
}
