amends "package://pkl.konna.cloud/pkl/wstool@1.0.2#/package.pkl"

package {
  name = "wstool-test-infrastructure"
  version = "1.0.0"
}

build {
  tool = "npm-wstool"
  networkIsolation = "isolated"
}

buildDependencies {
  ["npm-wstool"] = "1.0.0"
}

dependencies {
  ["cdktn"] = "0.24.0"
  ["@cdktn/provider-local"] = "14.0.1"
  ["@cdktn/provider-random"] = "15.0.1"
  ["constructs"] = "10.7.2"
  ["typescript"] = "5.9.3"
}
