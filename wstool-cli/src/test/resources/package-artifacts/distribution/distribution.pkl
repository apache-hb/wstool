amends "package://pkl.konna.cloud/pkl/wstool@1.0.2#/distribution.pkl"

local remoteRepository = read("env:ARTIFACT_REMOTE_REPOSITORY")
local consumerRepository = read("env:ARTIFACT_CONSUMER_REPOSITORY")
local toolchainRepository = read("env:WSTOOL_BUILD_TOOLS_REPOSITORY")
local toolchain = new GitRepository {
  name = "wstool-build-toolchain"
  version = "1.0.0"
  repo = toolchainRepository
}

platforms { "ubuntu:26.04" }

storage {
  bucket = read("env:ARTIFACT_BUCKET")
  endpoint = read("env:AWS_S3_ENDPOINT")
}

packages {
  new GitRepository {
    name = "remote-tool"
    version = "1.0.0"
    repo = remoteRepository
    branch = "master"
  }
  new GitRepository {
    name = "artifact-consumer"
    version = "1.0.0"
    repo = consumerRepository
    branch = "master"
  }
  new Folder { name = "wstool-copy-source"; version = "1.x"; from = toolchain; path = "." }
  new Folder {
    name = "corretto"
    version = "25"
    from = toolchain
    path = "packages/corretto"
  }
  new Folder {
    name = "wstool"
    version = "1.0.0"
    from = toolchain
    path = "packages/wstool"
  }
  new Folder {
    name = "ubuntu-rsync"
    version = "1.0.0"
    from = toolchain
    path = "packages/ubuntu-rsync"
  }
  new Folder {
    name = "ubuntu-libpopt0"
    version = "1.0.0"
    from = toolchain
    path = "packages/ubuntu-libpopt0"
  }
  new Folder {
    name = "ubuntu-busybox-static"
    version = "1.0.0"
    from = toolchain
    path = "packages/ubuntu-busybox-static"
  }
}
