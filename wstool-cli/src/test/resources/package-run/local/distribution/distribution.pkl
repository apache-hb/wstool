amends "package://pkl.konna.cloud/pkl/wstool@1.0.2#/distribution.pkl"

local localApp = read("env:LOCAL_APP_REPOSITORY")

platforms { "ubuntu:24.04" }

storage { bucket = "unused-test-bucket" }

packages {
  new GitRepository {
    name = "local-app"
    version = "1.0.0"
    repo = localApp
    branch = "master"
  }
}
