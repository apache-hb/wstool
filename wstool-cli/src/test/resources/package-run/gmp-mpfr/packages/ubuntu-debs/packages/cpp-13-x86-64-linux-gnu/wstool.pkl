amends "package://pkl.konna.cloud/pkl/wstool@1.0.2#/package.pkl"

package { name = "ubuntu-deb-cpp-13-x86-64-linux-gnu"; version = "1.0.0" }

local debsUrl = read("env:WSTOOL_GMP_MPFR_DEBS_URL")

build { tool = "install-deb" }

buildDependencies { ["ubuntu-deb-installer"] = "1.0.0" }

externalSources {
  sources {
    new FileSource {
      uri = "\(debsUrl)/debs/cpp-13-x86-64-linux-gnu.deb"
      path = "ubuntu-package.deb"
      checksum = read("env:WSTOOL_DEB_SHA256_CPP_13_X86_64_LINUX_GNU")
      license = "GPL-3.0-or-later"
    }
  }
}
