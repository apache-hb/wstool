amends "package://pkl.konna.cloud/pkl/wstool@1.0.2#/package.pkl"

package { name = "ubuntu-deb-libgprofng0"; version = "1.0.0" }

local debsUrl = read("env:WSTOOL_GMP_MPFR_DEBS_URL")

build { tool = "install-deb" }

buildDependencies { ["ubuntu-deb-installer"] = "1.0.0" }

externalSources {
  sources {
    new FileSource {
      uri = "\(debsUrl)/debs/libgprofng0.deb"
      path = "ubuntu-package.deb"
      checksum = read("env:WSTOOL_DEB_SHA256_LIBGPROFNG0")
      license = "NOASSERTION"
    }
  }
}
