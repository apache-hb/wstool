amends "package://pkl.konna.cloud/pkl/wstool@1.0.2#/package.pkl"

package { name = "gmp"; version = "6.3.0" }

local sourceUrl = read("env:WSTOOL_GMP_MPFR_SOURCE_URL")

build {
  tool = "wstool-gmp"
  sourceMount = "readwrite"
}

buildDependencies {
  ["ubuntu-build-tools"] = "1.0.0"
  ["corretto"] = "25"
  ["wstool"] = "1.0.0"
}

externalSources {
  sources {
    new ArchiveSource {
      uri = "\(sourceUrl)/sources/gmp-6.3.0.tar.xz"
      checksum = "a3c2b80201b89e68616f4ad30bc66aee4927c3ce50e33929ca819d5c43538898"
      stripComponents = 1
      license = "LGPL-3.0-or-later"
    }
  }
}
