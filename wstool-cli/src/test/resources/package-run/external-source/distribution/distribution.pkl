amends "package://pkl.konna.cloud/pkl/wstool@1.0.2#/distribution.pkl"

local externalSourceRepository = read("env:EXTERNAL_SOURCE_REPOSITORY")

platforms { "ubuntu:24.04" }

storage { bucket = "unused-test-bucket" }

packages {
  new GitRepository {
    name = "external-source-e2e"
    version = "1.0"
    repo = externalSourceRepository
    branch = "master"
  }
}
