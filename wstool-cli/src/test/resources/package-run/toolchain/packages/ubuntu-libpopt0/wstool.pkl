amends "package://pkl.konna.cloud/pkl/wstool@1.0.2#/package.pkl"

package { name = "ubuntu-libpopt0"; version = "1.0.0" }

local cacheUrl = read("env:WSTOOL_PACKAGE_CACHE_URL")

build { tool = "install-source" }

externalSources {
  sources {
    new ArchiveSource {
      uri = "\(cacheUrl)/ubuntu/libpopt0/data.tar.gz"
      checksum = read("env:WSTOOL_LIBPOPT_DATA_SHA256")
      license = "MIT"
    }
    new FileSource {
      uri = "\(cacheUrl)/ubuntu/libpopt0/control"
      path = "configuration/usr/share/doc/libpopt0/wstool-control"
      checksum = read("env:WSTOOL_LIBPOPT_CONTROL_SHA256")
      license = "MIT"
    }
  }
}
