amends "package://pkl.konna.cloud/pkl/wstool@1.0.2#/package.pkl"

package { name = "wstool"; version = "1.0.0" }

local cacheUrl = read("env:WSTOOL_PACKAGE_CACHE_URL")

build { tool = "install-runtime" }

externalSources {
  sources {
    new ArchiveSource {
      uri = "\(cacheUrl)/wstool.tar"
      checksum = read("env:WSTOOL_CLI_SHA256")
      stripComponents = 1
      license = "Apache-2.0"
    }
  }
}
