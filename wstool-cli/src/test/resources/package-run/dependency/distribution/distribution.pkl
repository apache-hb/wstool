amends "package://pkl.konna.cloud/pkl/wstool@1.0.2#/distribution.pkl"

local appRepository = read("env:DEPENDENCY_APP_REPOSITORY")
local toolRepository = read("env:DEPENDENCY_TOOL_REPOSITORY")
local toolchainRepository = read("env:WSTOOL_BUILD_TOOLS_REPOSITORY")
local toolchain = new GitRepository {
  name = "wstool-build-toolchain"
  version = "1.0.0"
  repo = toolchainRepository
}

platforms { "ubuntu:26.04" }

storage { bucket = "unused-test-bucket" }

packages {
  new GitRepository {
    name = "dependency-app"
    version = "1.0.0"
    repo = appRepository
    branch = "master"
  }
  new GitRepository {
    name = "tool-provider"
    version = "1.0.0"
    repo = toolRepository
    branch = "master"
  }
  new Folder { name = "wstool-copy-source"; version = "1.x"; from = toolchain; path = "." }
  new Folder {
    name = "corretto"
    version = "25"
    from = toolchain
    path = "packages/corretto"
  }
  new Folder {
    name = "wstool"
    version = "1.0.0"
    from = toolchain
    path = "packages/wstool"
  }
  new Folder {
    name = "ubuntu-rsync"
    version = "1.0.0"
    from = toolchain
    path = "packages/ubuntu-rsync"
  }
  new Folder {
    name = "ubuntu-libpopt0"
    version = "1.0.0"
    from = toolchain
    path = "packages/ubuntu-libpopt0"
  }
  new Folder {
    name = "ubuntu-busybox-static"
    version = "1.0.0"
    from = toolchain
    path = "packages/ubuntu-busybox-static"
  }
}
