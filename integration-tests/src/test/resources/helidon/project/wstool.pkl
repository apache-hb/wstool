amends "package://pkl.konna.cloud/pkl/wstool@1.0.2#/package.pkl"

package {
  name = "helidon-rest"
  version = "1.0.0"
}

buildOptions {
  tool = "wstool-gradle"
  networkIsolation = "isolated"
  sourceMount = "readonly"
}

buildDependencies {
  ["wstool-gradle"] = "1.0.0"
  ["io_helidon_webserver_helidon-webserver"] = "4.x"
}

dependencies {
  ["io_helidon_webserver_helidon-webserver"] = "4.x"
}
