amends "package://pkl.konna.cloud/pkl/wstool@1.0.2#/distribution.pkl"

import "package://pkl.konna.cloud/pkl/wstool@1.0.2#/distribution.pkl" as wstoolDistribution

import "packages.pkl" as importedNpmPackages

name = "cdktn-s3-integration"

platforms { "wstool-npm-integration:latest" }

storage {
  bucket = "wstool-npm-integration"
  endpoint = read("env:AWS_S3_ENDPOINT")
}

packages {
  new wstoolDistribution.Folder {
    name = "wstool-npm-import"
    version = "1.0.0"
    from = new wstoolDistribution.Archive {
      name = "wstool-npm-import"
      version = "1.0.0"
      uri = read("env:WSTOOL_NPM_IMPORT_PACKAGE_URI")
      checksum = read("env:WSTOOL_NPM_IMPORT_PACKAGE_CHECKSUM")
    }
    path = "."
  }
  new GitRepository {
    name = "cdktn-s3-project"
    version = "1.0.0"
    repo = read("env:WSTOOL_NPM_PROJECT_REPO")
    branch = "main"
  }
  ...importedNpmPackages.packages
}
