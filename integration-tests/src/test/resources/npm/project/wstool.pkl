amends "package://pkl.konna.cloud/pkl/wstool@1.0.1#/package.pkl"

import "npm-dependencies.pkl" as importedNpmDependencies

package {
  name = "npm-demo"
  version = "1.0.0"
}

buildOptions {
  tool = "npm-wstool"
  dockerImage = "wstool-npm-integration:latest"
  networkIsolation = "isolated"
  sourceMount = "readonly"
}

buildDependencies {
  ["wstool-npm-import"] = "1.0.0"
  ...importedNpmDependencies.buildDependencies
}

dependencies {
  ...importedNpmDependencies.dependencies
}
