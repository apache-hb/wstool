amends "package://pkl.konna.cloud/pkl/wstool@1.0.2#/package.pkl"

package {
  name = "third-party"
  version = "1.0.0"
}

buildOptions {
  tool = "local-build"
  networkIsolation = "isolated"
}

importOptions {
  source = new ExternalGitRepository {
    repo = read("env:WSTOOL_THIRD_PARTY_UPSTREAM_REPO")
    branch = "main"
  }
  license = "MIT"
  patches {
    read("patches/change-value.patch")
  }
}
