#!/bin/sh
set -eu
source_dir=
prefix_dir=
entrypoint=
platform=
container_image=
previous_argument=
while [ "$#" -gt 0 ]; do
  case "$1" in
    --volume)
      mount="$2"
      case "$mount" in
        *:/wstool/workspace/src/third-party:ro) source_dir="${mount%%:/wstool/workspace/src/third-party:ro}" ;;
        *:/wstool/workspace/private/prefix/third-party:rw) prefix_dir="${mount%%:/wstool/workspace/private/prefix/third-party:rw}" ;;
        *:/wstool/tools/local-build:ro) entrypoint="${mount%%:/wstool/tools/local-build:ro}" ;;
      esac
      shift 2
      ;;
    --entrypoint)
      shift 2
      ;;
    --env)
      case "$2" in
        WST_BUILD_IMAGE=*) platform="${2#WST_BUILD_IMAGE=}" ;;
      esac
      shift 2
      ;;
    *)
      if [ "$1" = release ]; then
        container_image="$previous_argument"
      fi
      previous_argument="$1"
      shift
      ;;
  esac
done
test -n "$source_dir"
test -n "$prefix_dir"
test -n "$entrypoint"
test "$platform" = wstool-third-party-integration:latest
test "$container_image" = "$platform"
WST_SRCDIR="$source_dir" WST_PREFIX="$prefix_dir" "$entrypoint" release
